---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import { works, type Lang, type WorkProject } from '../data/work';
import '../styles/pages.css';

interface Props {
  lang: Lang;
  project: WorkProject;
}

const { lang, project } = Astro.props;
const en = lang === 'en';
const root = en ? '/en/' : '/';
const index = works[lang].findIndex(item => item.slug === project.slug);
const next = works[lang][(index + 1) % works[lang].length];
const sections = [
  { id: 'context', label: en ? 'Context and role' : 'Контекст и моя работа' },
  { id: 'challenge', label: en ? 'Challenge' : 'Трудность' },
  { id: 'implementation', label: en ? 'Solution' : 'Решение' },
  { id: 'verification', label: en ? 'Verification' : 'Проверка' },
  { id: 'outcome', label: en ? 'Outcome' : 'Результат' },
  { id: 'limitations', label: en ? 'Limits' : 'Ограничения' },
  ...(project.sources.length ? [{ id: 'sources', label: en ? 'Explore' : 'Посмотреть' }] : []),
];
const leadLink = project.repo
  ? { href: project.repo, label: en ? 'View source code' : 'Посмотреть код' }
  : project.sources[0];
---

<Layout
  lang={lang}
  title={`${project.name} - ${project.category}`}
  description={project.summary}
  section="projects"
>
  <article class="case-page page-width">
    <a href={`${root}#experience`} class="back-link">
      <Icon name="back" size={15} />
      {en ? 'Back to selected work' : 'К выбранным работам'}
    </a>

    <header class="case-header">
      <div class="case-meta">
        <span class="eyebrow">{project.category}</span>
        <span class="case-kind">{project.kind}</span>
      </div>
      <h1>{project.name}</h1>
      <p>{project.summary}</p>
      <ul class="case-tech" aria-label={en ? 'Technology stack' : 'Технологии'}>
        {project.stack.map(technology => <li>{technology}</li>)}
      </ul>
      {leadLink && (
        <a class="case-repo text-link" href={leadLink.href} target="_blank" rel="noopener noreferrer">
          {leadLink.label}
          <Icon name="diagonal" size={15} />
        </a>
      )}
    </header>

    <figure class="real-case-flow">
      <figcaption class="eyebrow">{en ? 'HOW IT WORKS' : 'КАК ЭТО РАБОТАЕТ'}</figcaption>
      <ol class="flow-diagram" aria-label={en ? 'Project workflow' : 'Схема работы'}>
        {project.flow.map((step, i) => (
          <li><span>{String(i + 1).padStart(2, '0')}</span>{step}</li>
        ))}
      </ol>
    </figure>

    <div class="case-content">
      <aside class="case-index">
        <span class="eyebrow">{en ? 'CONTENTS' : 'СОДЕРЖАНИЕ'}</span>
        {sections.map(section => <a href={`#${section.id}`}>{section.label}</a>)}
      </aside>

      <div class="case-prose">
        <section id="context">
          <span class="prose-number">01</span>
          <h2>{en ? 'Context and my work' : 'Контекст и моя работа'}</h2>
          <p>{project.context}</p>
          <p class="case-role"><strong>{en ? 'My part.' : 'Моя зона.'}</strong> {project.responsibility}</p>
        </section>

        <section id="challenge">
          <span class="prose-number">02</span>
          <h2>{en ? 'The challenge' : 'С чем столкнулся'}</h2>
          <p>{project.challenge}</p>
        </section>

        <section id="implementation">
          <span class="prose-number">03</span>
          <h2>{en ? 'What I built' : 'Что сделал'}</h2>
          <ul class="approach-list">
            {project.implementation.map(item => <li>{item}</li>)}
          </ul>
        </section>

        <section id="verification">
          <span class="prose-number">04</span>
          <h2>{en ? 'How I checked it' : 'Как проверял'}</h2>
          <p>{project.verification}</p>
        </section>

        <section id="outcome">
          <span class="prose-number">05</span>
          <h2>{en ? 'Outcome' : 'Что получилось'}</h2>
          <p>{project.outcome}</p>
        </section>

        <section id="limitations">
          <span class="prose-number">06</span>
          <h2>{en ? 'Current limits' : 'Текущие ограничения'}</h2>
          <ul class="approach-list">
            {project.limitations.map(item => <li>{item}</li>)}
          </ul>
        </section>

        {project.sources.length > 0 && (
          <section id="sources">
            <span class="prose-number">07</span>
            <h2>{en ? 'Explore the work' : 'Посмотреть работу'}</h2>
            <div class="case-sources">
              {project.sources.map(source => (
                <a href={source.href} target="_blank" rel="noopener noreferrer">
                  {source.label}<Icon name="diagonal" size={14} />
                </a>
              ))}
            </div>
          </section>
        )}
      </div>
    </div>

    <a class="next-project" href={`${root}work/${next.slug}/`}>
      <div>
        <span class="eyebrow">{en ? 'NEXT PROJECT' : 'СЛЕДУЮЩАЯ РАБОТА'}</span>
        <h2>{next.name}</h2>
      </div>
      <Icon name="arrow" size={27} />
    </a>
  </article>
</Layout>
