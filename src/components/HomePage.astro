---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import ProjectDemo from './ProjectDemo';
import { projects, type Lang } from '../data/content';
import ExperienceSection from './ExperienceSection.astro';
import { getProfile } from '../data/profile';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const en = lang === 'en';
const root = en ? '/en/' : '/';
const work = projects[lang];
const profile = getProfile(lang);
---
<Layout lang={lang} title={`${profile.name} - ${profile.role}`}>
  <section class="intro page-width">
    <div class="intro-copy">
      <p class="eyebrow intro-label"><span class="tiny-cross">✳</span>PYTHON / TYPESCRIPT</p>
      <h1>{en ? 'APIs and' : 'API и'}<br /><span>{en ? 'backend development.' : 'серверная разработка.'}</span></h1>
      <p class="intro-description">{en ? 'I’m Vladislav, a backend developer from Saint Petersburg.' : 'Я Владислав, backend-разработчик из Санкт-Петербурга.'}<br class="desktop-break" />{en ? ' I build web services with Python and TypeScript, and work with PostgreSQL.' : ' Пишу веб-сервисы на Python и TypeScript, работаю с PostgreSQL.'}</p>
      <div class="intro-links"><a class="text-link" href="#experience">{en ? 'What I can do' : 'Что я умею'}<Icon name="arrow" size={16} /></a><span class="link-dot">·</span><a class="subtle-link" href={`${root}resume/`}>{en ? 'Résumé' : 'Резюме'}<Icon name="diagonal" size={14} /></a></div>
    </div>
    <div class="logic-object" aria-hidden="true">
      <div class="object-shadow"></div>
      <div class="object-base"><span>INPUT / OUTPUT</span><div class="base-grid"></div></div>
      <div class="object-layer layer-bottom"><div class="circuit-lines"><i></i><i></i><i></i></div><span>02</span></div>
      <div class="object-layer layer-top"><span class="object-asterisk">✳</span><span class="object-caption">request handler</span></div>
      <span class="object-note">{en ? 'server side' : 'на стороне сервера'}<svg viewBox="0 0 60 40" fill="none"><path d="M2 35C30 36 55 25 46 3m0 0-7 9m7-9 8 7" stroke="currentColor" stroke-width="1.2"/></svg></span>
    </div>
  </section>

  <ExperienceSection lang={lang} />

  <section class="work-section page-width" id="work" aria-labelledby="work-title">
    <div class="section-heading"><h2 id="work-title">{en ? 'Experiments' : 'Эксперименты'}<span class="item-count">03</span></h2><span class="section-aside">{en ? 'Interactive demos' : 'Интерактивные демо'}</span></div>
    <div class="project-grid">
      {work.map((project, index) => <article class:list={['project-card', `project-card-${project.slug}`, { 'project-card-wide': index === 2 }]}>
        <div class="project-stage"><ProjectDemo kind={project.slug} lang={lang} client:visible /></div>
        <div class="project-caption"><div class="project-caption-top"><span class="project-category">{project.category}</span><span class="concept-tag">{en ? 'Concept' : 'Концепт'}</span></div><a class="project-link" href={`${root}projects/${project.slug}/`}><h3>{project.title}</h3><span class="project-arrow"><Icon name="diagonal" size={19} /></span></a><p>{project.summary}</p>{index === 2 && <a class="text-link project-read" href={`${root}projects/${project.slug}/`}>{en ? 'Behind the system' : 'Как это устроено'}<Icon name="arrow" size={16} /></a>}</div>
      </article>)}
    </div>
    <p class="collection-note"><span class="note-mark">↳</span>{en ? 'The buttons run local demos. Each page explains the proposed backend.' : 'Кнопки запускают демо в браузере. На страницах разбираю, как могла бы работать серверная часть.'}</p>
  </section>

  <section class="about-section page-width" id="about">
    <div class="section-index"><span class="eyebrow">{en ? 'ABOUT' : 'О СЕБЕ'}</span><span class="handwritten">{en ? 'Saint Petersburg' : 'Санкт-Петербург'}</span></div>
    <div class="about-copy"><h2>{en ? 'Backend developer' : 'Backend-разработчик'}</h2><p>{en ? 'I have worked on booking services, document uploads, a product catalogue and store management software. These projects involved APIs, database design, user roles and admin panels.' : 'Работал с сервисами записи, загрузкой документов, каталогом товаров и приложением для учёта магазина. В этих проектах занимался API, структурой базы, ролями пользователей и административными панелями.'}</p><p>{en ? 'I also use React and Next.js to connect the interface to the backend. For deployment, I work with Docker, Compose and Nginx.' : 'Также работаю с React и Next.js: могу подключить интерфейс к backend и доработать формы. Для запуска приложений использую Docker, Compose и Nginx.'}</p>
      <div class="skill-groups">
        <div class="skill-group"><span>Backend</span><p>Python · Django / DRF · TypeScript · Node.js</p></div>
        <div class="skill-group"><span>{en ? 'Data' : 'Данные'}</span><p>PostgreSQL · SQL · PL/pgSQL</p></div>
        <div class="skill-group"><span>{en ? 'Tools' : 'Инструменты'}</span><p>Docker · Nginx · Git</p></div>
        <div class="skill-group"><span>{en ? 'Interface' : 'Интерфейс'}</span><p>React · Next.js</p></div>
      </div>
      <p class="education-note">{en ? 'Information Systems and Programming · 2026' : 'Информационные системы и программирование · 2026'}<span>{en ? 'Peter the Great St. Petersburg Polytechnic University · Secondary vocational education' : 'СПбПУ Петра Великого · Среднее профессиональное образование'}</span></p>
    </div>
  </section>

  <section class="resume-strip page-width" aria-labelledby="resume-title">
    <div class="paper-stack" aria-hidden="true"><div></div><div></div><div><span>CURRICULUM VITÆ</span><b>Résumé</b><i></i><i></i><i></i><span class="paper-draft">RU / EN</span></div></div>
    <div class="resume-strip-copy"><span class="eyebrow">{en ? 'RÉSUMÉ' : 'РЕЗЮМЕ'}</span><h2 id="resume-title">{en ? 'Experience and skills' : 'Опыт и навыки'}</h2><p>{en ? 'Read online or download a PDF or Word copy in Russian or English.' : 'Можно прочитать на сайте или скачать PDF и Word на русском и английском.'}</p><a class="text-link" href={`${root}resume/`}>{en ? 'Open résumé' : 'Открыть резюме'}<Icon name="arrow" size={16} /></a></div>
    <span class="resume-formats">PDF<br />DOCX<br /><span>RU / EN</span></span>
  </section>

  <section class="contact-section page-width"><div><span class="eyebrow">{en ? 'CONTACT' : 'КОНТАКТЫ'}</span><h2>{en ? 'Discuss a project or role' : 'Обсудить проект или вакансию'}</h2></div><button class="contact-cta" data-contact-open>{en ? 'Contact me' : 'Написать мне'}<Icon name="diagonal" size={20} /></button></section>
</Layout>
