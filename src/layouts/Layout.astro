---
import '@fontsource-variable/inter';
import '../styles/global.css';
import '../styles/profile.css';
import Icon from '../components/Icon.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { contacts, getProfile } from '../data/profile';
interface Props { title: string; description?: string; lang?: 'ru' | 'en'; section?: string; }
const { title, description, lang = 'ru', section = 'home' } = Astro.props;
const en = lang === 'en';
const profile = getProfile(lang);
const root = en ? '/en/' : '/';
const current = Astro.url.pathname;
const equivalent = section === 'none' ? (en ? '/' : '/en/') : en ? current.replace(/^\/en(?=\/)/, '') : `/en${current}`;
const nav = [
  { id: 'home', icon: 'home', label: en ? 'Home' : 'Главная', href: root },
  { id: 'projects', icon: 'grid', label: en ? 'Experience' : 'Опыт', href: `${root}#experience` },
  { id: 'about', icon: 'person', label: en ? 'About' : 'О себе', href: `${root}#about` },
  { id: 'resume', icon: 'file', label: en ? 'Résumé' : 'Резюме', href: `${root}resume/` },
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description || (en ? `${profile.name} - backend development, automation and service integrations. Projects, experience and résumé.` : `${profile.name} - backend-разработка, автоматизация и интеграции. Проекты, опыт и резюме.`)} />
    <meta name="author" content={profile.name} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      try { if (localStorage.getItem('portfolio-theme') === 'dark') document.documentElement.dataset.theme = 'dark'; } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{en ? 'Skip to content' : 'Перейти к содержимому'}</a>
    <header class="site-header">
      <a class="identity" href={root} aria-label={en ? 'Home - backend portfolio' : 'Главная - backend-портфолио'}>
        <span class="rosette" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="identity-text">{profile.name}<span>backend developer</span></span>
      </a>
      <div class="header-right">
        <a class="edition" href={contacts[0].href} target="_blank" rel="noopener noreferrer">@huteex<span class="edition-dot"></span></a>
        <nav class="languages" aria-label={en ? 'Language' : 'Язык'}>
          <a href={section === 'none' ? '/' : en ? equivalent : current} lang="ru" aria-current={!en ? 'page' : undefined}>RU</a><span>/</span><a href={section === 'none' ? '/en/' : en ? current : equivalent} lang="en" aria-current={en ? 'page' : undefined}>EN</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><span>{en ? 'Saint Petersburg' : 'Санкт-Петербург'}</span><nav class="footer-contacts" aria-label={en ? 'Social links and email' : 'Соцсети и почта'}>{contacts.map(contact => <a href={contact.href} target={contact.id === 'email' ? undefined : '_blank'} rel={contact.id === 'email' ? undefined : 'noopener noreferrer'}>{contact.label}</a>)}</nav><span>© 2026</span></footer>
    <nav class="dock" aria-label={en ? 'Main navigation' : 'Основная навигация'}>
      {nav.map(item => <a class:list={['dock-item', { active: section === item.id }]} href={item.href} aria-label={item.label} aria-current={section === item.id ? 'page' : undefined}><Icon name={item.icon} /><span class="dock-label">{item.label}</span><span class="dock-dot"></span></a>)}
      <span class="dock-divider"></span>
      <button class="dock-item" data-contact-open aria-label={en ? 'Contact' : 'Связаться'}><Icon name="mail" /><span class="dock-label">{en ? 'Contact' : 'Связаться'}</span></button>
      <button class="dock-item theme-toggle" data-theme-toggle aria-label={en ? 'Toggle colour theme' : 'Переключить цветовую тему'} aria-pressed="false"><span class="theme-sun"><Icon name="sun" /></span><span class="theme-moon"><Icon name="moon" /></span><span class="dock-label">{en ? 'Theme' : 'Тема'}</span></button>
    </nav>
    <dialog id="contact-dialog" class="contact-dialog" aria-labelledby="contact-title" aria-describedby="contact-description">
      <div class="dialog-top"><span class="eyebrow">{en ? 'CONTACT' : 'КОНТАКТЫ'}</span><button data-contact-close class="icon-button" aria-label={en ? 'Close' : 'Закрыть'}><Icon name="close" /></button></div>
      <h2 id="contact-title">{en ? 'Contact me' : 'Написать мне'}</h2>
      <p id="contact-description">{en ? 'Contact me on Telegram or by email about a role or a project.' : 'По вопросам работы и проектов можно написать в Telegram или на почту.'}</p>
      <ContactLinks lang={lang} />
      <a class="text-link" href={`${root}resume/`}>{en ? 'View résumé' : 'Посмотреть резюме'}<Icon name="arrow" size={16} /></a>
    </dialog>
    <script>
      const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const setPressed = () => themeButton?.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark'));
      setPressed();
      themeButton?.addEventListener('click', () => {
        const dark = document.documentElement.dataset.theme !== 'dark';
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        try { localStorage.setItem('portfolio-theme', dark ? 'dark' : 'light'); } catch {}
        setPressed();
      });
      const contact = document.querySelector<HTMLDialogElement>('#contact-dialog');
      document.querySelectorAll('[data-contact-open]').forEach(el => el.addEventListener('click', () => contact?.showModal()));
      document.querySelector('[data-contact-close]')?.addEventListener('click', () => contact?.close());
      contact?.addEventListener('click', e => { if (e.target === contact) { const r = contact.getBoundingClientRect(); if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) contact.close(); } });
    </script>
  </body>
</html>
